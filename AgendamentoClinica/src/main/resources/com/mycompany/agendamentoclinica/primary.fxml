<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agendamentoclinica.PrimaryController">
   <children>
      <Label text="Cadastro de Paciente" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
      <TextField fx:id="campoNome" promptText="Nome Completo" />
      <TextField fx:id="campoCpf" promptText="CPF" />
      <TextField fx:id="campoEmail" promptText="E-mail" />
      <TextField fx:id="campoTelefone" promptText="Telefone" />
      <PasswordField fx:id="campoSenha" promptText="Senha Forte" />
      <Button fx:id="btnCadastrar" onAction="#clicouCadastrar" text="Cadastrar" />
      <Label fx:id="labelMensagem" text="" />
   </children>
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
</VBox>