<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="painelPrincipal" focusTraversable="true" alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agendamentoclinica.PrimaryController">
   <children>
      <Label text="Agendamento de Clínica" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
      <Label text="Escolha uma opção para começar:" />
      
      <Button mnemonicParsing="false" onAction="#irParaLogin" prefHeight="40.0" prefWidth="200.0" text="Fazer Login" />
      <Button mnemonicParsing="false" onAction="#irParaCadastro" prefHeight="40.0" prefWidth="200.0" text="Criar Cadastro" />
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>