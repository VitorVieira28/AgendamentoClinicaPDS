<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="painelPrincipal" focusTraversable="true" alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agendamentoclinica.AgendamentoController">
   <children>
      <Label text="Agendar Nova Consulta" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
      
      <Label fx:id="labelDadosPaciente" text="Paciente: Carregando... | CPF: ..." style="-fx-text-fill: #777777; -fx-font-size: 13px;" />
      
      <Label text="Selecione a Data:" style="-fx-font-weight: bold;" />
      <DatePicker fx:id="calendarioConsulta" prefWidth="250.0" promptText="Escolha o dia" />
      
      <Label text="Selecione o Horário:" style="-fx-font-weight: bold;" />
      <ComboBox fx:id="comboHorarios" prefWidth="250.0" promptText="Escolha a hora" />
      
      <Button onAction="#clicouMarcarConsulta" text="Confirmar Agendamento" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="200.0">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Button>
      
      <Label fx:id="labelMensagem" text="" />
      
      <Button onAction="#voltarInicio" text="Sair / Voltar ao Início" />
   </children>
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
</VBox>