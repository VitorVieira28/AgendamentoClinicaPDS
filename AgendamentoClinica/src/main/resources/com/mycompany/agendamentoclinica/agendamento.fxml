<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agendamentoclinica.AgendamentoController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="Agendar Nova Consulta" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label text="Preencha os dados abaixo para marcar seu horário:" style="-fx-font-size: 14px;"/>
    
    <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #f4f4f4; -fx-padding: 20; -fx-background-radius: 10;">
        <!-- SCRUM-45: ComboBox para selecionar o médico -->
        <ComboBox fx:id="comboMedicos" promptText="Selecione o Profissional" prefWidth="300" onAction="#aoEscolherMedico"/>
        
        <!-- SCRUM-47: Calendário bloqueado por padrão -->
        <DatePicker fx:id="datePickerData" promptText="Selecione a Data" prefWidth="300" disable="true"/>
        
        <Label fx:id="labelHorarios" text="Selecione um médico para ver os horários" style="-fx-text-fill: gray;"/>
    </VBox>
    
    <Button text="Confirmar Agendamento" onAction="#clicouAgendar" prefWidth="300" style="-fx-font-weight: bold; -fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    
    <Label fx:id="labelMensagem"/>
    
    <Button text="Voltar ao início" onAction="#voltarAoInicio"/>
</VBox>