<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="painelPrincipal" focusTraversable="true" alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agendamentoclinica.LoginController">
   <children>
      <Label text="Login do Paciente" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
      
      <TextField fx:id="campoEmailLogin" promptText="Digite seu E-mail" maxWidth="300" />
      <PasswordField fx:id="campoSenhaLogin" promptText="Digite sua Senha" maxWidth="300" />
      
      <Button onAction="#clicarEntrar" text="Entrar" style="-fx-background-color: #28a745; -fx-text-fill: white;" prefWidth="100.0" />
      <Label fx:id="labelMensagemLogin" text="" />
      
      <Button onAction="#voltarInicio" text="Voltar ao Início" />
   </children>
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
</VBox>