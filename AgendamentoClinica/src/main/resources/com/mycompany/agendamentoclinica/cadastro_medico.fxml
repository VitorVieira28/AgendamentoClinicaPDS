<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox focusTraversable="true" alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agendamentoclinica.CadastroMedicoController">
    <children>
        <Label text="Cadastro de Médico" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        
        <TextField fx:id="campoNome" promptText="Nome Completo" maxWidth="300"/>
        <TextField fx:id="campoCrm" promptText="CRM" maxWidth="300"/>
        <TextField fx:id="campoEmail" promptText="Digite seu E-mail" maxWidth="300"/>
        <TextField fx:id="campoTelefone" promptText="Telefone" maxWidth="300"/>
        <PasswordField fx:id="campoSenha" promptText="Senha Forte" maxWidth="300"/>
        
        <Button text="Cadastrar" onAction="#clicouCadastrarMedico" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" prefWidth="100.0" />
        
        <Label fx:id="labelMensagem"/>
        
        <Button text="Voltar ao Início" onAction="#voltarAoInicio"/>
    </children>
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
</VBox>