<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agendamentoclinica.AgendaMedicoController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <Label text="Gerenciamento de Agenda" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    
    <HBox alignment="CENTER" spacing="10">
        <Label text="Selecione o Dia:" style="-fx-font-weight: bold;"/>
        <!-- SCRUM-48: Calendário da Agenda -->
        <DatePicker fx:id="datePickerAgenda" onAction="#carregarHorariosDaData"/>
    </HBox>

    <VBox alignment="CENTER" spacing="5" prefWidth="350" maxWidth="350">
        <Label text="Lista de Horários (Clique para alternar o status):" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>
        <!-- SCRUM-48: Lista de Horários -->
        <ListView fx:id="listaHorarios" prefHeight="200" onMouseClicked="#alterarStatusSelecionado"/>
    </VBox>
    
    <Label fx:id="labelAviso" text="Clique em um horário para torná-lo Vago ou Indisponível." style="-fx-text-fill: #555555; -fx-font-style: italic;"/>
    
    <Button text="Sair (Logout)" onAction="#fazerLogout" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;"/>
</VBox>