<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="painelPrincipal" focusTraversable="true" alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.agendamentoclinica.CadastroController">
   <children>
      <Label text="Cadastro de Paciente" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
      <TextField fx:id="campoNome" promptText="Nome Completo" maxWidth="300" />
      <TextField fx:id="campoCpf" promptText="CPF" maxWidth="300" />
      <TextField fx:id="campoEmail" promptText="E-mail" maxWidth="300" />
      <TextField fx:id="campoTelefone" promptText="Telefone" maxWidth="300" />
      <PasswordField fx:id="campoSenha" promptText="Senha Forte" maxWidth="300" />
      
      <Button fx:id="btnCadastrar" onAction="#clicouCadastrar" text="Cadastrar" style="-fx-background-color: #007bff; -fx-text-fill: white;" />
      <Label fx:id="labelMensagem" text="" />
      
      <Button onAction="#voltarInicio" text="Voltar ao Início" />
   </children>
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
</VBox>